# --- Analyse des colonnes (utilisée par le pushforward ET le rollout) ---
def parse_feature(name):
    field, rest = name.replace("@", "").split("(")
    time_lab, space_lab = rest.rstrip(")").split(",")
    k = {"t": 0, "t-dt": 1, "t-2dt": 2}[time_lab]
    off = 0 if space_lab == "j" else int(space_lab[1:])
    return field, k, off

SPEC = [parse_feature(c) for c in INPUTS]

mu_in  = norm_stats.loc[INPUTS,  "mean"].values.astype(np.float32)
sd_in  = norm_stats.loc[INPUTS,  "std" ].values.astype(np.float32)
mu_out = norm_stats.loc[OUTPUTS, "mean"].values.astype(np.float32)
sd_out = norm_stats.loc[OUTPUTS, "std" ].values.astype(np.float32)

def u_right_pf(A, omega, t):
    return A * np.sin(omega * t) if t < 2 * np.pi / omega else 0.0

def build_window(m_list, field_at):
    """Matrice de features normalisée (n_nodes, n_inputs).
    m_list[lag_idx] = indice temporel du lag ; field_at(m) -> champ u complet."""
    X = np.zeros((len(nodes), len(INPUTS)), np.float32)
    for i, (field, lag_idx, off) in enumerate(SPEC):
        m = m_list[lag_idx]
        if field == "u_dot":
            val = (field_at(m) - field_at(m - ndt)) / (ndt * dt)
        else:
            val = field_at(m)
        X[:, i] = val[nodes + off]
    return (X - mu_in) / sd_in

def reconstruct_field(u_curr, n_curr, pred_norm, A, omega):
    """Reconstruit le champ prédit à n_curr+ndt depuis les deltas normalisés."""
    delta = pred_norm[:, 0] * sd_out[0] + mu_out[0]
    uu = np.zeros(Ntot)
    uu[nodes]     = u_curr[nodes] + delta
    uu[:i_left+1] = 0.0
    uu[i_right:]  = u_right_pf(A, omega, (n_curr + ndt) * dt)
    return uu

PF_SAMPLES = [(A, omega, n)
              for (A, omega) in FIELDS
              for n in range(3*ndt, Nt - 2*ndt + 1)]
print(f"Échantillons pushforward : {len(PF_SAMPLES):,}")

# Architecture du réseau
