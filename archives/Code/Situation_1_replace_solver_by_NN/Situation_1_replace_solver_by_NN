line_pred, = ax_anim.plot([], [], color='orange', lw=2, ls='--', label='Prédit (Réseau/Roll-out)')
title_text = ax_anim.set_title('')
ax_anim.set_xlabel("Position (x)")
ax_anim.set_ylabel("Déplacement (u)")
ax_anim.legend(loc="upper left")
ax_anim.grid(True)

liste_temps = list(reel.keys())

def init_anim():
    line_reel.set_data([], [])
