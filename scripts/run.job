#!/bin/bash
# One parametrized Slurm job, replacing the 4 separate .job files each old
# project directory used to carry (one per project, each with its own
# copy-pasted absolute path). Usage:
#   sbatch scripts/run.job configs/runs/<run_id>.yaml
#
# Assumes: (1) this repo is checked out at REPO_ROOT below (update it to
# match your cluster home), (2) `pip install -e .` has been run once inside
# PYTHON's venv so `python -m beamsurrogate` resolves.
#SBATCH --job-name=beamsurrogate
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --exclusive   # whole node to itself: a node has ~125G total (sinfo),
                       # so two of these jobs sharing one node already risks
                       # exceeding physical RAM even before either nears its
                       # own --mem request (see incident 148864-148866, three
                       # runs launched together all landed on node mohawk
                       # with 96+96+120=312G combined requested)
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x_%j.log
#SBATCH --error=logs/%x_%j.err
#SBATCH --partition=medium
set -euo pipefail

REPO_ROOT="/home/aph25/Code_GH"     # <-- update to this repo's actual path on the cluster
cd "$REPO_ROOT"
mkdir -p logs
# logs/ used to be auto-purged here (`find ... -delete` every file not
# matching this job's own ID). That raced between jobs starting together on
# the same node: one job's cleanup tried to delete another's just-opened
# log, NFS refused ("Device or resource busy"), and under set -e that
# killed the training run before it ever reached Python (jobs
# 148864/148865/148866, all launched within 3s of each other on node
# mohawk). Stale logs are cheap -- clean them up by hand instead.

if [[ $# -lt 1 ]]; then
    echo "Usage: sbatch scripts/run.job configs/runs/<run_id>.yaml" >&2
    exit 1
fi
CONFIG="$1"

# Without this, squeue shows every run as the #SBATCH --job-name above
# (fixed at submit time, before this script -- and this run's config -- is
# even read), making concurrent jobs indistinguishable. Best-effort and
# non-fatal: scontrol being unsupported/denied must never take the run down.
scontrol update JobId="$SLURM_JOB_ID" JobName="$(basename "$CONFIG" .yaml)" 2>/dev/null || true

# Matches --cpus-per-task above (NOT 1) -- benchmarked empirically: torch's
# intra-op matmul threading gives ~5x throughput at BATCH_SIZE=4096 with 8
# threads vs 1, on this node. Only safe because this job owns its whole
# Slurm allocation; 1 was needed for the SEPARATE, unrelated case of running
# beamsurrogate directly in an interactive shell on a shared login node,
# where torch would otherwise grab far more threads than the node can host.
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 NUMEXPR_NUM_THREADS=8 VECLIB_MAXIMUM_THREADS=8
PYTHON=/home/aph25/Desktop/wave_env/bin/python

time "$PYTHON" -u -m beamsurrogate --config "$CONFIG"
echo "RUN DONE: $CONFIG"
