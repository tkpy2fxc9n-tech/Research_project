#!/bin/bash
# One parametrized Slurm job, replacing the 4 separate .job files each old
# project directory used to carry (one per project, each with its own
# copy-pasted absolute path). Usage:
#   sbatch scripts/run.job runs/<phase>/<run_id>/config.yaml
#
# Assumes: (1) this repo is checked out at REPO_ROOT below (update it to
# match your cluster home), (2) `pip install -e .` has been run once inside
# PYTHON's venv so `python -m beamsurrogate` resolves.
#SBATCH --job-name=beamsurrogate
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
# No --exclusive (removed 2026-08-14, was here since incident 148864-148866:
# three under-specified --mem=96G jobs landed on the same node and hit
# 96+96+120=312G combined, well past physical RAM). That incident was really
# about --mem not reflecting real usage, not about node-sharing itself --
# Slurm's cgroup enforces each job's own --mem as a hard per-job ceiling
# regardless of what else is on the node, so once --mem is set to what a run
# actually needs (measure via `sacct -j <id> --format=MaxRSS`, bump with
# `sbatch --mem=<X>G scripts/run.job ...` for a heavy config), co-location is
# safe again. Dropping --exclusive matters because it was making every run
# wait for an entire node to sit fully idle before starting (observed
# blocking heavy-feature/PINN runs behind other users' jobs for hours), a far
# stricter wait than "somewhere with enough free memory."
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x_%j.log
#SBATCH --error=logs/%x_%j.err
# --nodelist=fury,mohawk removed 2026-08-18: pinning two nodes by name also
# pinned their memory ceiling, and fury only has 128G. A heavy config (e.g.
# M_BACK=3 with features [U, Ut] = 138 inputs, ~110G peak) can then never be
# scheduled there, and would sit queued or die on OOM for no reason. Letting
# the partition choose lets Slurm match the job's --mem against every node
# it has (dragon/gauntlet/mohawk are 256G, fury 128G) instead of against a
# hand-picked pair.
#SBATCH --partition=medium
set -euo pipefail

REPO_ROOT="/home/aph25/Code_GH"     # <-- update to this repo's actual path on the cluster
cd "$REPO_ROOT"
mkdir -p logs
# logs/ used to be auto-purged here (`find ... -delete` every file not
# matching this job's own ID). That raced between jobs starting together on
# the same node: one job's cleanup tried to delete another's just-opened
# log, NFS refused ("Device or resource busy"), and under set -e that
# killed the training run before it ever reached Python (jobs
# 148864/148865/148866, all launched within 3s of each other on node
# mohawk). Stale logs are cheap -- clean them up by hand instead.

if [[ $# -lt 1 ]]; then
    echo "Usage: sbatch scripts/run.job runs/<phase>/<run_id>/config.yaml" >&2
    exit 1
fi
CONFIG="$1"

# Without this, squeue shows every run as the #SBATCH --job-name above
# (fixed at submit time, before this script -- and this run's config -- is
# even read), making concurrent jobs indistinguishable. Best-effort and
# non-fatal: scontrol being unsupported/denied must never take the run down.
# A run's identity is its folder name (runs/<phase>/<run_id>/config.yaml),
# NOT the filename "config.yaml" itself -- basename "$CONFIG" would give
# "config" for every single run.
scontrol update JobId="$SLURM_JOB_ID" JobName="$(basename "$(dirname "$CONFIG")")" 2>/dev/null || true

# Matches --cpus-per-task above (NOT 1) -- benchmarked empirically: torch's
# intra-op matmul threading gives ~5x throughput at BATCH_SIZE=4096 with 8
# threads vs 1, on this node. Safe to pin at 8 regardless of what else is
# co-located on the node (no --exclusive anymore, see above): Slurm's cgroup
# constrains this job to its --cpus-per-task=8 allocation on its own, that
# was never actually dependent on owning the whole node. 1 was needed for
# the SEPARATE, unrelated case of running beamsurrogate directly in an
# interactive shell on a shared login node, where torch would otherwise
# grab far more threads than the node can host.
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 NUMEXPR_NUM_THREADS=8 VECLIB_MAXIMUM_THREADS=8
PYTHON=/home/aph25/Desktop/wave_env/bin/python

# --output/--error above are fixed by Slurm at submit time (logs/%x_%j.log),
# before this script -- let alone the run's own folder -- has been read, so
# Slurm can never write directly into runs/<phase>/<run_id>/logs/. Instead,
# copy the finished Slurm log there ourselves once the run dir is known. %x
# resolves to the job name Slurm had when it opened the file, i.e. the
# --job-name above (the scontrol rename above happens too late to affect
# it), which is exactly $SLURM_JOB_NAME's value for the rest of this
# script's life. A trap (not a line after the python call) so the log is
# still copied if the run dies partway through.
save_slurm_log() {
    local run_dir
    run_dir="$(dirname "$CONFIG")"
    mkdir -p "$run_dir/logs"
    cp -f "logs/${SLURM_JOB_NAME}_${SLURM_JOB_ID}.log" "$run_dir/logs/" 2>/dev/null || true
    cp -f "logs/${SLURM_JOB_NAME}_${SLURM_JOB_ID}.err" "$run_dir/logs/" 2>/dev/null || true
}
trap save_slurm_log EXIT

time "$PYTHON" -u -m beamsurrogate --config "$CONFIG"
echo "RUN DONE: $CONFIG"
