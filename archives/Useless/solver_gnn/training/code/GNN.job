#!/bin/bash
#SBATCH --job-name=gnn_pde
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --mem=72G
#SBATCH --time=5:59:00
#SBATCH --output=logs/%x_%j.log
#SBATCH --error=logs/%x_%j.err
#SBATCH --partition=short
#SBATCH --chdir=/home/aph25/Tests_archives/Archives/solver_gnn/training

set -uo pipefail

# The --chdir above sets the job's working directory (and therefore where the
# logs/ path above resolves) BEFORE the script even starts -- so sbatch can be
# launched from training/ OR training/code/ without the logs ending up in the
# wrong place (ambiguity fixed on 2026-07-22).
cd /home/aph25/Tests_archives/Archives/solver_gnn/training
mkdir -p logs
find logs -maxdepth 1 -type f ! -name "*${SLURM_JOB_ID}*" -delete

PYTHON=/home/aph25/Desktop/wave_env/bin/python

# No OMP_NUM_THREADS=1 pin here (unlike commun.job, which is calibrated for
# comparing several methods running in parallel): this job launches a single
# process, and GNN training benefits from a multi-threaded BLAS (see
# torch.set_num_threads(8) in main.py).
# main.py lives in code/ (plots -> training/plots/simulation_<timestamp>/,
# model -> solver_gnn/model.pth, cf. PLOTS_DIR/PROJECT_DIR in main.py).
time "$PYTHON" -u code/main.py --epochs 20

echo "DONE"
