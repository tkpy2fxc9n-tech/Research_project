    line_pred.set_data(x, pred[t])
    title_text.set_text(f"Évolution temporelle — t = {t:.3f} s")
    return line_reel, line_pred, title_text

ani = animation.FuncAnimation(fig_anim, update_anim, frames=liste_temps[::4], init_func=init_anim, blit=True)

