#!/bin/bash
#SBATCH --job-name=suppression_hf
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --time=5:59:00
#SBATCH --output=suppression_hf_%j.log
#SBATCH --error=suppression_hf_%j.err
#SBATCH --partition=short

set -uo pipefail   # no -e: a variant that crashes must not prevent the
                    # others from running, nor the aggregation from being tried

cd /home/aph25/recherche/suppression_hautes_frequences

PYTHON=/home/aph25/Desktop/wave_env/bin/python

# 6 independent variants launched in parallel in the background, each
# allocated an equal share of the job's cores (avoids oversubscribing the
# 6 torch/numpy processes onto the same cores).
VARIANTS=(v0_baseline v1_smoothing v2_noise_injection v3_spectral_penalty v4_spectral_filter v5_pushforward)

THREADS_PER_RUN=$(( SLURM_CPUS_PER_TASK / ${#VARIANTS[@]} ))
if [ "$THREADS_PER_RUN" -lt 1 ]; then THREADS_PER_RUN=1; fi
export OMP_NUM_THREADS="$THREADS_PER_RUN"
export MKL_NUM_THREADS="$THREADS_PER_RUN"
export OPENBLAS_NUM_THREADS="$THREADS_PER_RUN"
export NUMEXPR_NUM_THREADS="$THREADS_PER_RUN"
export VECLIB_MAXIMUM_THREADS="$THREADS_PER_RUN"

mkdir -p logs
# Clean up logs from previous runs (without touching those of the current job,
# already opened by Slurm at launch).
find logs -maxdepth 1 -type f ! -name "*${SLURM_JOB_ID}*" -delete

PIDS=()
for v in "${VARIANTS[@]}"; do
    script="(Uxx, Ut)=>(delta_u) and ndt=5 et N et M_${v}.py"
    echo "=== Launching ${v} (${script}) ==="
    "$PYTHON" -u "$script" > "logs/run_${v}_${SLURM_JOB_ID}.log" 2>&1 &
    PIDS+=("$!")
done

FAILED=0
for i in "${!PIDS[@]}"; do
    if ! wait "${PIDS[$i]}"; then
        echo "FAILED: variant ${VARIANTS[$i]} -- see logs/run_${VARIANTS[$i]}_${SLURM_JOB_ID}.log" >&2
        FAILED=1
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo "At least one variant failed: the aggregation will only cover the successful variants (missing ones are skipped with a warning by compare_methodes.py)." >&2
fi

# --- Aggregation: reads outputs_<variant>/metrics.json for each variant ---
echo "=== Aggregation (Comparatifs/compare_methodes.py) ==="
cd Comparatifs
"$PYTHON" -u compare_methodes.py
cd ..

echo "SUPPRESSION_HAUTES_FREQUENCES JOB DONE"
