## Simulation comparative pas à pas (Roll-out)
A = AMPLITUDES[2]
omega = PULSATIONS[2]
dx = L / (Nx - 1)
dt = t_end / Nt
x = np.linspace(0, L, Nx)

stats_normalisation = {name: {"mean": norm_stats.loc[name, "mean"], "std": norm_stats.loc[name, "std"]} for name in INPUTS + OUTPUTS}
mu_du = stats_normalisation[OUTPUTS[0]]["mean"]
sd_du = stats_normalisation[OUTPUTS[0]]["std"]

t_pulse = 2 * np.pi / omega
def u_right(t):
    return A * np.sin(omega * t) if t < t_pulse else 0.0

# 1) VRAIE simulation : schema centre
v = np.sqrt(E / rho)
CFL = v * dt / dx
u   = np.zeros(Nx)      
u_2 = np.zeros(Nx)      
reel = {0.0: u.copy()}

for n in range(Nt):
    t = n * dt
    t_suivant=round((n+1)*dt, 5)
    u_new = np.zeros(Nx)
    u_new[1:-1] = 2*u[1:-1] - u_2[1:-1] + CFL**2 * (u[2:] - 2*u[1:-1] + u[:-2])
    u_new[0]  = 0.0
    u_new[-1] = u_right(t+dt)
    u_2 = u.copy()
    u   = u_new
    reel[t_suivant] = u.copy()

# 2) Simulation PREDITE : Roll-out complet
u   = np.zeros(Nx)      
u_1 = np.zeros(Nx)      
pred = {0.0: u.copy()}
noms_features = [c[:-2] for c in INPUTS_N]   

for n in range(Nt):
    t = n * dt
    t_suivant = round((n+1)*dt, 5)

    u_xx = np.zeros(Nx)
    u_xx[1:-1] = (u[2:] - 2*u[1:-1] + u[:-2]) / dx**2
    u_dot = (u - u_1) / dt

    variables_physiques = {"u_xx": u_xx, "u_dot": u_dot}
    entree = np.zeros((Nx, len(INPUTS_N)), dtype=np.float32)
    for idx, name in enumerate(noms_features):
        entree[:, idx] = (variables_physiques[name] - stats_normalisation[name]["mean"]) / stats_normalisation[name]["std"]

    with torch.no_grad():
        sortie = modele(torch.tensor(entree)).numpy().ravel()

    delta_u = sortie * sd_du + mu_du
    u_new = np.zeros(Nx)
    u_new[1:-1] = u[1:-1] + delta_u[1:-1]
    u_new[0]  = 0.0
    u_new[-1] = u_right(t+dt)

    u_1 = u.copy()
    u   = u_new
    pred[t_suivant] = u.copy()

# =====================================================
# 3) Génération et Sauvegarde du GIF Animé (Réel vs Prédit)
# =====================================================
print("Génération du GIF comparatif en cours...")
