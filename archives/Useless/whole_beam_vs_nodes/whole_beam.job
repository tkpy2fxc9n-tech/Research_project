#!/bin/bash
#SBATCH --job-name=whole_beam
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=5:59:00
#SBATCH --output=whole_beam_%j.log
#SBATCH --error=whole_beam_%j.err
#SBATCH --partition=short

set -euo pipefail

export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export MKL_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export OPENBLAS_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export NUMEXPR_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export VECLIB_MAXIMUM_THREADS="${SLURM_CPUS_PER_TASK}"

# Move into the directory containing this script, no matter where
# `sbatch` was launched from.
cd "$(dirname "$(readlink -f "$0")")"

# --- Activate the "wave_env" conda environment -------------------------
# (numpy/pandas/torch/matplotlib/openpyxl). TO BE ADJUSTED once connected to
# the cluster if the module or env name differs from what is detected here.
if command -v module >/dev/null 2>&1; then
    module load anaconda3 2>/dev/null || module load miniconda3 2>/dev/null || true
fi

CONDA_SH=""
for base in "$(conda info --base 2>/dev/null || true)" "$HOME/anaconda3" "$HOME/miniconda3" "/opt/anaconda3" "/opt/miniconda3"; do
    if [ -n "$base" ] && [ -f "$base/etc/profile.d/conda.sh" ]; then
        CONDA_SH="$base/etc/profile.d/conda.sh"
        break
    fi
done
if [ -z "$CONDA_SH" ]; then
    echo "conda.sh not found: adjust the env loading (module / conda path) for this cluster." >&2
    exit 1
fi
source "$CONDA_SH"
conda activate wave_env

# 800 epochs / 40 simulations: the heaviest run of the three folders.
# If --time=5:59:00 is not enough on this cluster, increase it (or switch to
# a long partition) once the actual duration has been observed.
time python -u "(Uxx, Ut)=>(delta_u) and ndt=5 et N et M.py"

echo "WHOLE_BEAM JOB DONE"
