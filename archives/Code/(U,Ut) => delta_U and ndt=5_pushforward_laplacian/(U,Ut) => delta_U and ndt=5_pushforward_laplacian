# ============================================================
# PUSHFORWARD LOSS (Brandstetter et al. 2022)
# Bloc 1 (sans gradient) : entrées vraies -> état prédit "corrompu".
# Bloc 2 (avec gradient) : depuis l'état corrompu, revenir vers la vérité.
# ============================================================
def pushforward_loss(n_groups):
    idxs   = np.random.choice(len(PF_SAMPLES), n_groups, replace=False)
    groups = [PF_SAMPLES[i] for i in idxs]

    # Bloc 1 : entrées vraies, sans gradient
    X1 = np.concatenate([
        build_window([n, n-ndt, n-2*ndt], lambda m, U=FIELDS[(A, omega)]: U[m])
        for (A, omega, n) in groups
    ], axis=0)
    with torch.no_grad():
        pred1 = modele(torch.tensor(X1)).numpy()

    # Bloc 2 : depuis l'état prédit (corrompu), AVEC gradient
    nN = len(nodes)
    X2_list, tgt_list = [], []
    for j, (A, omega, n) in enumerate(groups):
        U_sim    = FIELDS[(A, omega)]
        u_hat    = reconstruct_field(U_sim[n], n, pred1[j*nN:(j+1)*nN], A, omega)
        nprime   = n + ndt
        field_at = lambda m, U=U_sim, uh=u_hat, np_=nprime: uh if m == np_ else U[m]
        X2_list.append(build_window([nprime, nprime-ndt, nprime-2*ndt], field_at))
        curr = u_hat[nodes]
        tgt  = ((U_sim[nprime + ndt][nodes] - curr) - mu_out) / sd_out
        tgt_list.append(tgt.astype(np.float32).reshape(-1, 1))

    pred2 = modele(torch.tensor(np.concatenate(X2_list, axis=0)))
    return criterion(pred2, torch.tensor(np.concatenate(tgt_list, axis=0)))

historique_train = []
historique_val   = []
historique_pf    = []

meilleure_val = float("inf")
patience_compteur = 0

for epoch in range(1, N_EPOCHS + 1):

    lam_pf = LAMBDA_PF * min(1.0, epoch / PF_WARMUP)

    # Phase entraînement
    modele.train()
    perte_train    = 0.0
    perte_pf_total = 0.0
    for X_batch, y_batch in train_loader:

        optimiseur.zero_grad()

        # Loss de données : entrée bruitée, cible propre
        X_in      = X_batch + NOISE_STD * torch.randn_like(X_batch)
        prediction = modele(X_in)
        data_loss  = criterion(prediction, y_batch)

        # Loss pushforward
        pf_loss    = pushforward_loss(N_PF_GROUPS) if lam_pf > 0 else torch.tensor(0.0)
        total_loss = data_loss + lam_pf * pf_loss
        total_loss.backward()

        optimiseur.step()

        perte_train    += data_loss.item()
        perte_pf_total += pf_loss.item()
    perte_train    /= len(train_loader)
    perte_pf_total /= len(train_loader)

    # Phase validation : un seul forward pass sur tout le val
    modele.eval()
    with torch.no_grad():
        pred_val = modele(torch.tensor(X_val)).numpy()

    perte_val = ((pred_val - y_val)**2).mean()
    scheduler.step(perte_val)

    historique_train.append(perte_train)
    historique_val  .append(perte_val)
    historique_pf   .append(perte_pf_total)

    if epoch % 2 == 0:
        print(f"Epoch {epoch:4d}/{N_EPOCHS}  —  "
            f"data: {perte_train:.4f}  |  pushf: {perte_pf_total:.4f}  |  val: {perte_val:.4f}")

    if perte_val < meilleure_val:
        meilleure_val = perte_val
        torch.save(modele.state_dict(), OUTPUT_DIR / "model.pth")

