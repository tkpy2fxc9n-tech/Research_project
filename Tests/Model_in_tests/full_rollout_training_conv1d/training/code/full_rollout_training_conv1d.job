#!/bin/bash
#SBATCH --job-name=full_rollout_conv1d
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --time=2:30:00
#SBATCH --output=logs/full_rollout_conv1d_%j.log
#SBATCH --error=logs/full_rollout_conv1d_%j.err
#SBATCH --partition=short

set -euo pipefail

# To be launched from training/ (cd Model_in_tests/full_rollout_training_conv1d/training && sbatch code/full_rollout_training_conv1d.job) --
# logs/ above and mkdir -p logs below are therefore relative to training/,
# consistent with the training/{code,logs,plots} structure. code/ contains
# main.py (plots -> training/plots/simulation_<day>/, model ->
# Model_in_tests/full_rollout_training_conv1d/model.pth, see PLOTS_DIR/PROJECT_DIR in main.py).
cd /home/aph25/Tests/Model_in_tests/full_rollout_training_conv1d/training

# logs/ must exist BEFORE Slurm starts the job (the --output/--error paths
# above are opened as soon as it launches, before the first line of the
# script) -- already created, but recreated here in case the folder was
# deleted between two runs.
mkdir -p logs
# Cleans up logs from previous runs (without touching those of the current
# job, already opened by Slurm at launch).
find logs -maxdepth 1 -type f ! -name "*${SLURM_JOB_ID}*" -delete

# 1 thread per process: dataset.py spreads the FD simulations across the
# allocated cpus via ProcessPoolExecutor -- a higher OMP_NUM_THREADS would
# oversubscribe the cpus. Training itself is forced to 1 thread anyway by
# training.py (torch.set_num_threads(1)).
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

PYTHON=/home/aph25/Desktop/wave_env/bin/python

# main.py now trains with a composite loss (rollout TBPTT + physics
# residual + one-step data, see train.py) -- --group-size/--tbptt-hops/
# --lambda-data/--lambda-physics/--lambda-rollout are all real flags again,
# left at their Config defaults below (no override passed). Early stopping
# (--early-stop-patience, default 15) caps the worst case.
#
# NOTE: --time above was tuned for the earlier plain one-step scheme, which
# was much cheaper per epoch than this composite scheme's full autoregressive
# rollout -- re-time a real run (or extrapolate from --smoke-test's reported
# per-group seconds) before trusting this budget on the cluster.
time "$PYTHON" -u code/main.py

echo "FULL_ROLLOUT_TRAINING_CONV1D JOB DONE"
