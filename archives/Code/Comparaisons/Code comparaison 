from pathlib import Path

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import openpyxl

SCRIPT_DIR = Path(__file__).resolve().parent
OUTPUT_DIR = SCRIPT_DIR / "outputs"
OUTPUT_DIR.mkdir(exist_ok=True)

xlsx_path = SCRIPT_DIR / "comparative_table.xlsx"

# --- Lecture du fichier Excel (une seule fois) ---
wb = openpyxl.load_workbook(xlsx_path, data_only=True)
ws = wb.active

headers = [c.value for c in ws[1]]
print("Colonnes trouvées :", headers)

def col_index(nom):
    return headers.index(nom)   # 0-based

def extraire(nom):
    ci = col_index(nom)
    ci_time = ci - 1                     # la colonne temps est juste à gauche
    ts, es = [], []
    for row in ws.iter_rows(min_row=2, values_only=True):
        t = row[ci_time]
        e = row[ci]
        if t is None or e is None:
            continue
        ts.append(float(t))
        es.append(float(e))
    return ts, es

def tracer(colonnes, nom_fichier, titre):
    # échelle log
    plt.figure(figsize=(9, 5))
    for nom in colonnes:
        ts, es = extraire(nom)
        plt.plot(ts, es, "o-", ms=3, label=nom)
    plt.yscale("log")
    plt.xlabel("t"); plt.ylabel("erreur")
    plt.title(f"{titre} (échelle log)")
    plt.grid(True, which="both"); plt.legend()
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / f"{nom_fichier}_log.png", dpi=150, bbox_inches="tight")
    plt.close()

    # échelle linéaire
    plt.figure(figsize=(9, 5))
    for nom in colonnes:
        ts, es = extraire(nom)
        plt.plot(ts, es, "o-", ms=3, label=nom)
    plt.xlabel("t"); plt.ylabel("erreur")
    plt.title(f"{titre} (échelle linéaire)")
    plt.grid(True); plt.legend()
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / f"{nom_fichier}_lin.png", dpi=150, bbox_inches="tight")
    plt.close()

# --- Comparaison 1 : les trois modèles ---
tracer(["U", "U_Ut", "Ut_Uxx"], "comparaison_3modeles", "Erreur des différents modèles")

# --- Comparaison 2 : effet du pushforward + Laplacien + PINN ---
tracer(["Ut_Uxx", "Ut_Uxx_PF_Lap", "Ut_Uxx_PF_Lap_PINN"], "comparaison_PF_Lap", "Ut_Uxx : brut vs PF+lissage vs PF+lissage+PINN")

print(f"Plots sauvegardés dans {OUTPUT_DIR}")